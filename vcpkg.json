{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "f3-recomp",
  "version-string": "0.1",
  "builtin-baseline": "9e593bb18ea69cc5095e012465dcd675a822ed0d",
  "dependencies": [
    "cpp-httplib",
    "cpp-yyjson",
    "highway",
    "yojimbo",
    "zlib"
  ],
  "features": {
    "frontend": {
      "description": "SDL3 frontend with Dear ImGui (F3RT_SDL)",
      "dependencies": [
        "sdl3",
        {
          "name": "imgui",
          "features": ["sdl3-binding", "sdl3-renderer-binding"]
        }
      ]
    },
    "gpu": {
      "description": "SDL3 GPU presentation and offline shader tools (F3RT_GPU)",
      "dependencies": [
        {
          "name": "f3-recomp",
          "features": ["frontend"]
        },
        {
          "name": "imgui",
          "features": ["sdlgpu3-binding"]
        },
        {
          "name": "glslang",
          "host": true,
          "features": ["tools"]
        },
        {
          "name": "spirv-cross",
          "host": true
        }
      ]
    },
    "tests": {
      "description": "GoogleTest and RapidCheck unit tests (BUILD_TESTING)",
      "dependencies": [
        "gtest",
        "rapidcheck"
      ]
    }
  }
}
